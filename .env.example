NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_API="https://api.example.com"

# Upstream API auth (required at build time for static generation of /api/* routes)
PPHAT_API_KEY=

# Resend email (used by contact form)
